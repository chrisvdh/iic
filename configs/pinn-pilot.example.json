{
  "name": "public-pinn-pilot-example",
  "mode": "pilot",
  "seeds": [0, 1],
  "points": [
    {
      "nu": 0.5,
      "rho": 0.0
    },
    {
      "nu": 2.0,
      "rho": 3.0
    },
    {
      "nu": 6.0,
      "rho": 6.0
    }
  ],
  "data": {
    "nx": 64,
    "nt": 50,
    "n_collocation": 500,
    "collocation_seed": 0
  },
  "model": {
    "hidden_widths": [16, 16],
    "activation": "tanh",
    "initialization": "he_normal"
  },
  "training": {
    "device": "cpu",
    "dtype": "float32",
    "weight_decay": 0.0,
    "phases": [
      {
        "optimizer": "lbfgs",
        "learning_rate": 1.0,
        "max_iter": 5000,
        "max_eval": 6250,
        "history_size": 100,
        "tolerance_grad": 1e-07,
        "tolerance_change": 1e-09,
        "line_search_fn": "strong_wolfe"
      }
    ]
  },
  "regularizer": {
    "include_initialization": true,
    "include_pde": true,
    "include_bea": false,
    "pde_weight": 1.0,
    "boundary_role": "explicit_regularizer",
    "boundary_weight": 1.0
  },
  "evaluation": {
    "mode": "full_iic",
    "profile": "cpu",
    "device": "cpu",
    "dtype": "float64",
    "linear_algebra_device": "cpu",
    "linear_algebra_dtype": "float64",
    "hessian_backend": "dense",
    "inverse_backend": "solve",
    "volume_backend": "exact",
    "compute_direct_iic": false,
    "numerical_jitter": 0.0,
    "workers": 1,
    "workers_per_gpu": 1,
    "cpu_threads_per_worker": 1,
    "finite_penalty_rhos": [10.0, 100.0],
    "spectral_absolute_floor": 1e-14,
    "stationarity_absolute_tolerance": 1e-7,
    "stationarity_relative_tolerance": 1e-7,
    "max_memory_gib": 8.0,
    "reference_solver": {
      "solver": "gradient_descent",
      "starts": 4,
      "include_theta_star_start": true,
      "random_scale": 0.1,
      "learning_rate": 0.05,
      "max_steps": 2000,
      "gradient_tolerance": 1e-7,
      "relative_gradient_tolerance": 1e-7,
      "armijo_coefficient": 0.0001,
      "backtrack_factor": 0.5,
      "max_backtracks": 25,
      "minimum_step": 1e-12,
      "seed": 0
    }
  },
  "gate": {
    "enabled": true,
    "interpolation_threshold": 0.001,
    "failure_error_threshold": 0.1,
    "require_interpolating": 1,
    "require_nonfailed": 1,
    "require_failed": 1
  }
}
